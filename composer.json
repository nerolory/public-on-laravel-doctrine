{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "gedmo/doctrine-extensions": "^3.22",
        "google/analytics-data": "^0.29.0",
        "intervention/image": "^4.4",
        "jaybizzle/crawler-detect": "^1.4",
        "laravel-doctrine/extensions": "^2.0",
        "laravel-doctrine/migrations": "^3.4",
        "laravel-doctrine/orm": "^3.3",
        "laravel/framework": "^12.0",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^2.10.1",
        "league/flysystem-aws-s3-v3": "^3.35",
        "moonshine/apexcharts": "^3.1",
        "moonshine/moonshine": "^4.18",
        "socialiteproviders/apple": "^6.1",
        "socialiteproviders/vkid": "^5.1",
        "socialiteproviders/yandex": "^4.2",
        "spatie/laravel-feed": "^4.5",
        "spatie/laravel-sitemap": "^8.2",
        "spatie/schema-org": "^5.0",
        "symfony/html-sanitizer": "^8.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "12.x-dev"
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
